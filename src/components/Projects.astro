---
import { projects } from "../data/site";
import { lookup } from "../data/glossary";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
---

<section id="services" class="relative scroll-mt-24 py-24 sm:py-32">
  <!-- The 3D cloud crosses to the left edge for this section. -->
  <div class="pointer-events-none sticky top-[calc(50vh-9rem)] h-0" aria-hidden="true">
    <div
      class="absolute -left-24 top-0 h-[18rem] w-[22rem] sm:-left-16"
      data-cloud-anchor="3"
      data-cloud-alpha="0.5"
    >
    </div>
  </div>

  <div class="container-px">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading eyebrow="Services" title="What I do" />
      <a
        href="https://github.com/loriamichaelj"
        target="_blank"
        rel="noopener noreferrer"
        class="reveal group inline-flex items-center gap-2 text-sm text-white/60 transition-colors hover:text-white"
      >
        All repositories on GitHub
        <Icon name="external" class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
      </a>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {
        projects.map((p, i) => (
          <div class="reveal" data-reveal="flip" data-delay={`${(i % 3) * 110}`}>
            <article
              class="card-surface skill-card group flex h-full items-center gap-5 p-6 sm:p-7"
              data-tilt="8"
              data-service-card
              role="button"
              tabindex="0"
              aria-haspopup="dialog"
              aria-label={`${p.title}: show details`}
            >
              <span class="relative flex h-14 w-14 shrink-0 items-center justify-center" data-service-icon>
                <span class="icon-glass absolute inset-0 rounded-2xl transition-transform duration-700 group-hover:rotate-[14deg] group-hover:scale-110" />
                <Icon name={p.icon} class="relative h-6 w-6 text-white" />
              </span>

              <h3 class="pr-10 font-display text-lg font-semibold leading-snug text-white sm:text-xl">{p.title}</h3>

              <span class="skill-expand" aria-hidden="true">
                <Icon name="expand" class="h-3.5 w-3.5" />
              </span>

              {/* The card face is just the icon and title; the details are copied into the expanded card. */}
              <template data-service-details>
                <p class="text-base leading-relaxed text-white/70" data-rise>{p.blurb}</p>

                <div>
                  <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45" data-rise>
                    Tools · tap one for a quick definition
                  </p>
                  <ul class="mt-3 flex flex-wrap gap-2">
                    {p.tags.map((t) => {
                      const entry = lookup(t);
                      return (
                        <li data-rise>
                          {entry ? (
                            <button
                              type="button"
                              class="term-chip px-3.5 py-1.5 text-sm"
                              data-term={entry.key}
                              aria-haspopup="dialog"
                              aria-expanded="false"
                              aria-controls="term-card"
                            >
                              {t}
                            </button>
                          ) : (
                            <span class="term-chip term-chip-static px-3.5 py-1.5 text-sm">{t}</span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>

                <div class="flex items-center gap-3 border-t border-white/5 pt-5" data-rise>
                  <a
                    href={p.code}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/link inline-flex items-center gap-2 text-sm font-medium text-white/80 transition-colors hover:text-white"
                  >
                    <Icon name="github" class="h-4 w-4" />
                    View on GitHub
                    <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover/link:translate-x-1" />
                  </a>
                  {p.demo && (
                    <a
                      href={p.demo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ml-auto inline-flex items-center gap-1.5 text-sm font-medium text-white/80 transition-colors hover:text-white"
                    >
                      Live demo
                      <Icon name="external" class="h-3.5 w-3.5" />
                    </a>
                  )}
                </div>
              </template>
            </article>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- The floating card a service expands into (src/scripts/service-card.ts) -->
<div id="service-overlay" class="skill-overlay" hidden>
  <div class="skill-backdrop" data-expand-backdrop></div>
  <div class="skill-panel" role="dialog" aria-modal="true" aria-labelledby="service-title" tabindex="-1" data-expand-panel>
    <div class="skill-head flex items-start justify-between gap-4" data-service-head>
      <div class="flex items-center gap-4">
        <span class="relative flex h-14 w-14 shrink-0 items-center justify-center">
          <span class="icon-glass absolute inset-0 rounded-2xl"></span>
          <span class="relative flex text-white" data-service-icon-slot></span>
        </span>
        <div>
          <p class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.25em] text-white/50">
            <span class="h-1.5 w-1.5 rounded-full bg-aqua shadow-[0_0_12px_rgb(var(--c-aqua)_/_0.7)]"></span>
            Services
          </p>
          <h3 id="service-title" class="mt-2 font-display text-2xl font-semibold text-white sm:text-3xl" data-service-title></h3>
        </div>
      </div>
      <button type="button" class="icon-glass flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-white/80 hover:text-white" aria-label="Close" data-expand-close>
        <Icon name="close" class="h-[18px] w-[18px]" />
      </button>
    </div>
    <div class="service-body" data-service-body data-lenis-prevent></div>
  </div>
</div>

<script>
  import "../scripts/service-card";
</script>
