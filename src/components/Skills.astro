---
import { skills } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section id="skills" class="relative scroll-mt-24 py-24 sm:py-32">
  <div class="container-px grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
    <div>
      <SectionHeading eyebrow="Stack" title="Tools I work with" />
      <!-- Desktop: the 3D cloud returns to the left column. -->
      <div
        class="sticky top-[calc(50vh-9rem)] mt-10 hidden h-[18rem] w-full max-w-[24rem] lg:block"
        data-cloud-anchor="4"
        data-cloud-alpha="0.9"
        aria-hidden="true"
      >
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        skills.map((group, i) => (
          <div class="reveal" data-reveal="scale" data-delay={`${(i % 2) * 90}`}>
            <div class="card-surface h-full p-6" data-tilt="6">
              <h3 class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.2em] text-white/55">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-gradient shadow-[0_0_12px_rgb(var(--c-rose)_/_0.9)]" />
                {group.label}
              </h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-white/80 transition-all duration-300 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/[0.07] hover:text-white">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
