---
import { profile, nav } from "../data/site";
import Landscape from "./Landscape.astro";
const year = 2027;
---

<!-- The footer is the ground the landscape above it stands on. -->
<footer class="site-footer relative py-10">
  <Landscape />
  <div class="container-px flex flex-col items-center justify-between gap-6 sm:flex-row">
    <p class="footer-text text-sm">
      © {year} {profile.name}. All rights reserved.
    </p>

    <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="footer-text footer-link text-sm transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
