---
import { profile, socials, heroRotator } from "../data/site";
import Icon from "./Icon.astro";

// "Michael J. Loria" -> "Michael J." on one line, "Loria" in gradient below.
const parts = profile.name.split(" ");
const lastName = parts.pop() ?? "";
const firstLine = parts.join(" ");
const firstChars = [...firstLine];
const lastChars = [...lastName];
---

<section id="top" class="relative flex min-h-[100svh] items-center pb-16 pt-28 sm:pt-32">
  <div class="container-px relative grid items-center gap-6 lg:grid-cols-[1.2fr_1fr] lg:gap-4">
    <div class="relative z-10">
      <p class="eyebrow reveal flex items-center gap-3">
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inset-0 animate-ping-soft rounded-full bg-[rgb(var(--c-dot))]"></span>
          <span class="relative h-2 w-2 rounded-full bg-[rgb(var(--c-dot))]"></span>
        </span>
        {profile.role}
      </p>

      <h1 class="hero-title mt-6 font-display text-[clamp(2.6rem,7.25vw,5.75rem)] font-bold leading-[0.98] tracking-tight">
        <span class="sr-only">{profile.name}</span>
        <span class="block whitespace-nowrap" aria-hidden="true">
          {firstChars.map((c, i) => (
            <span class="hero-char" style={`--i:${i}`}>{c === " " ? " " : c}</span>
          ))}
        </span>
        <span class="block whitespace-nowrap" aria-hidden="true">
          {lastChars.map((c, j) => (
            <span
              class="hero-char hero-char-gradient"
              style={`--i:${firstChars.length + j}; --j:${j}; --n:${lastChars.length}`}
            >
              {c}
            </span>
          ))}
        </span>
      </h1>

      <p class="reveal mt-6 font-display max-sm:whitespace-nowrap text-[length:min(1.5rem,calc((100vw_-_3rem)/18.2))] font-medium text-white/85 sm:text-3xl" data-delay="700">
        {heroRotator.prefix}
        <span class="rotator" data-rotator>
          {heroRotator.words.map((w, i) => (
            <span class={`rotator-word text-gradient ${i === 0 ? "is-active" : ""}`}>{w}</span>
          ))}
        </span>
        {heroRotator.suffix}
      </p>

      <p
        class="reveal card-surface card-glass card-glass-sheer mt-6 max-w-xl p-5 text-base leading-relaxed text-white/75 sm:p-6 sm:text-lg"
        data-delay="820"
      >
        {profile.headline}
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-4" data-delay="940">
        <a href="#experience" class="btn-glow group" data-magnetic="0.25">
          See my projects
          <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
        </a>
      </div>

      <ul class="reveal mt-10 flex items-center gap-3" data-delay="1060">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.icon === "email" ? undefined : "_blank"}
                rel="noopener noreferrer"
                aria-label={s.label}
                class="icon-btn"
                data-magnetic="0.35"
              >
                <Icon name={s.icon} class="h-[18px] w-[18px]" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!--
      Where the 3D cloud sits at the top of the page. The WebGL scene reads this
      box (data-cloud-anchor); the SVG inside is the no-WebGL fallback.
    -->
    <div class="relative justify-self-center lg:justify-self-end">
      <div
        id="hero-cloud"
        class="relative aspect-[5/4] w-[min(84vw,22rem)] sm:w-[26rem] lg:w-[31rem]"
        data-cloud-anchor="0"
        data-cloud-alpha="1"
      >
        <div class="cloud-fallback absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <div class="absolute inset-8 animate-float rounded-full bg-brand-gradient opacity-30 blur-3xl"></div>
          <svg viewBox="0 0 24 24" class="relative w-3/4 animate-float drop-shadow-[0_20px_40px_rgba(123,97,255,0.45)]">
            <defs>
              <linearGradient id="cloud-fallback-fill" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="0.55" stop-color="#c7b6ff" />
                <stop offset="1" stop-color="#7b61ff" />
              </linearGradient>
            </defs>
            <path d="M17.5 19H7a5 5 0 1 1 .9-9.92A6.5 6.5 0 0 1 20.4 11 4 4 0 0 1 17.5 19Z" fill="url(#cloud-fallback-fill)" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
