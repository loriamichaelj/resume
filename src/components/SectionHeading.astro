---
interface Props {
  eyebrow: string;
  title?: string;
  align?: "left" | "center";
}
const { eyebrow, title, align = "left" } = Astro.props;

const words = title?.split(" ") ?? [];
---

<div class={`relative isolate ${align === "center" ? "text-center" : ""}`}>
  <div class="reveal">
    <p class={`eyebrow ${align === "center" ? "justify-center" : ""} flex items-center gap-3`}>
      {align === "left" && <span class="inline-block h-px w-8 bg-aqua" />}
      {eyebrow}
    </p>
    {
      title ? (
        <h2 class="mt-4 font-display text-4xl font-bold tracking-tight sm:text-5xl">
          <span class="sr-only">{title}</span>
          {words.map((w, i) => (
            <>
              <span class="heading-word" aria-hidden="true">
                <span style={`--i:${i}`}>{w}</span>
              </span>{" "}
            </>
          ))}
        </h2>
      ) : (
        <h2 class="sr-only">{eyebrow}</h2>
      )
    }
  </div>
</div>
