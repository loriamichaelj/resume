---
import { profile, certifications } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const stats = [
  { value: "AWS + Azure + GCP", label: "AWS & Azure Certified · CLF-C02 & AZ-900" },
  { value: "Bachelor's of Science", label: "Computer Science · CSULA" },
];
---

<section id="about" class="relative scroll-mt-24 py-24 sm:py-32">
  <!-- Narrow screens: the cloud steps aside to the right edge, off the text. -->
  <div class="pointer-events-none sticky top-[calc(50vh-9rem)] h-0 lg:hidden" aria-hidden="true">
    <div
      class="absolute -right-32 top-0 h-[18rem] w-[20rem]"
      data-cloud-anchor="1"
      data-cloud-alpha="0.5"
    >
    </div>
  </div>

  <div class="container-px grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <div>
      <SectionHeading eyebrow="About" />
      <!-- Desktop: the 3D cloud flies over from the hero and parks here. -->
      <div
        class="sticky top-[calc(50vh-9rem)] mt-10 hidden h-[18rem] w-full max-w-[24rem] lg:block"
        data-cloud-anchor="1"
        data-cloud-alpha="1"
        aria-hidden="true"
      >
      </div>
    </div>

    <div>
      <p class="reveal card-surface card-glass p-6 text-lg leading-relaxed text-white/75 sm:p-8 sm:text-xl" data-delay="80">
        {profile.bio}
      </p>

      <!-- Stacked, so each stat fits on one line. -->
      <dl class="mt-10 grid grid-cols-1 gap-4">
        {
          stats.map((s, i) => (
            <div class="reveal" data-reveal="flip" data-delay={`${160 + i * 120}`}>
              <div class="card-surface h-full overflow-hidden p-6" data-tilt="10">
                <dt class="whitespace-nowrap font-display text-xl font-bold sm:text-2xl">
                  <span class="text-gradient">{s.value}</span>
                </dt>
                <dd class="mt-2 whitespace-nowrap text-xs text-white/55 sm:text-sm">{s.label}</dd>
                <span
                  class="pointer-events-none absolute -bottom-10 -right-10 h-28 w-28 rounded-full bg-brand-gradient opacity-25 blur-2xl"
                  aria-hidden="true"
                />
              </div>
            </div>
          ))
        }
      </dl>

      <div class="reveal mt-8" data-delay="320">
        <svg class="absolute h-0 w-0" aria-hidden="true">
          <defs>
            <linearGradient id="cert-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" style="stop-color: rgb(var(--c-aqua))" />
              <stop offset="0.5" style="stop-color: rgb(var(--c-violet))" />
              <stop offset="1" style="stop-color: rgb(var(--c-rose))" />
            </linearGradient>
          </defs>
        </svg>
        <p class="eyebrow mb-3">Certifications</p>
        <ul class="flex flex-col gap-3">
          {
            certifications.map((c) => (
              <li class="card-surface group flex items-center gap-4 px-5 py-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl icon-glass transition-transform duration-500 group-hover:rotate-6 group-hover:scale-110">
                  <Icon name="badge-check" class="h-5 w-5 [stroke:url(#cert-grad)]" />
                </span>
                <span class="font-mono text-sm font-medium">
                  <span class="text-gradient">{c.code}</span>
                </span>
                <span class="text-sm text-white/80">{c.name}</span>
                <span class="ml-auto hidden text-xs text-white/45 sm:inline">{c.status}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
