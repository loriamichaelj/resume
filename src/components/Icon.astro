---
// Inline SVG icons. UI icons come from Lucide (lucide-static, ISC), read at
// build time, so nothing ships but the markup. GitHub keeps its filled brand
// mark.
import cloud from "lucide-static/icons/cloud.svg?raw";
import cloudCog from "lucide-static/icons/cloud-cog.svg?raw";
import container from "lucide-static/icons/container.svg?raw";
import layers from "lucide-static/icons/layers.svg?raw";
import codeXml from "lucide-static/icons/code-xml.svg?raw";
import chartLine from "lucide-static/icons/chart-line.svg?raw";
import shieldCheck from "lucide-static/icons/shield-check.svg?raw";
import badgeCheck from "lucide-static/icons/badge-check.svg?raw";
import arrowRight from "lucide-static/icons/arrow-right.svg?raw";
import arrowUpRight from "lucide-static/icons/arrow-up-right.svg?raw";
import mapPin from "lucide-static/icons/map-pin.svg?raw";
import moon from "lucide-static/icons/moon.svg?raw";
import sun from "lucide-static/icons/sun.svg?raw";
import menu from "lucide-static/icons/menu.svg?raw";
import info from "lucide-static/icons/info.svg?raw";
import close from "lucide-static/icons/x.svg?raw";
import expand from "lucide-static/icons/maximize-2.svg?raw";

const lucide = {
  cloud,
  "cloud-cog": cloudCog,
  container,
  layers,
  "code-xml": codeXml,
  "chart-line": chartLine,
  "shield-check": shieldCheck,
  "badge-check": badgeCheck,
  arrow: arrowRight,
  external: arrowUpRight,
  pin: mapPin,
  moon,
  sun,
  menu,
  info,
  close,
  expand,
};

export type IconName = keyof typeof lucide | "github";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = "h-5 w-5", strokeWidth = 1.75 } = Astro.props;

// The shapes inside Lucide's <svg> wrapper.
const inner = name in lucide ? lucide[name as keyof typeof lucide].replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, "") : "";
---

{
  name === "github" && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.4-1.27.73-1.56-2.56-.29-5.26-1.28-5.26-5.7 0-1.26.45-2.3 1.2-3.1-.12-.3-.52-1.48.1-3.08 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.83 0c2.2-1.5 3.18-1.18 3.18-1.18.63 1.6.23 2.78.11 3.08.75.8 1.2 1.84 1.2 3.1 0 4.43-2.7 5.4-5.28 5.69.42.36.79 1.06.79 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
    </svg>
  )
}
{
  inner && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={inner}
    />
  )
}
