---
import { marquee } from "../data/site";

// Two tilted rows of tool names drifting in opposite directions. motion.ts
// moves them, speeds them up with scroll velocity and flips them with scroll
// direction. Each row repeats its items twice so the loop is seamless.
const half = Math.ceil(marquee.length / 2);
const rows = [marquee, [...marquee.slice(half), ...marquee.slice(0, half)]];
---

<section aria-label="Tools I use" class="relative overflow-hidden py-10 sm:py-14">
  <div class="-mx-[5%] flex -rotate-2 flex-col gap-4 [perspective:900px]">
    {
      rows.map((items, r) => (
        <div class="marquee-row [transform:rotateX(14deg)]" data-marquee={r === 0 ? "1" : "-1"}>
          <ul class="marquee-track" aria-hidden={r === 1 ? "true" : undefined}>
            {[...items, ...items].map((item, i) => (
              <li
                class="flex shrink-0 items-center gap-3 rounded-full border border-white/10 bg-ink-900/70 px-5 py-2.5 font-display text-base font-medium text-white/80 sm:text-lg"
                aria-hidden={i >= items.length ? "true" : undefined}
              >
                <span
                  class="h-2 w-2 rounded-full bg-brand-gradient"
                  style={`background-position: ${(i % items.length) * 13}% 0; background-size: 600% 100%`}
                />
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
