---
import { experience } from "../data/site";
import { glossary, lookup } from "../data/glossary";
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

const badge = {
  project: { label: "Project", class: "bg-rose/15 text-rose ring-rose/30" },
  work: { label: "Work", class: "bg-flame/15 text-flame ring-flame/30" },
  education: { label: "Education", class: "bg-violet/20 text-violet ring-violet/30" },
};
---

<section id="experience" class="relative scroll-mt-24 py-24 sm:py-32">
  <!-- The 3D cloud drifts at the right edge, behind the cards, while you read. -->
  <div class="pointer-events-none sticky top-[calc(50vh-9rem)] h-0" aria-hidden="true">
    <div
      class="absolute -right-24 top-0 h-[18rem] w-[22rem] sm:-right-16"
      data-cloud-anchor="2"
      data-cloud-alpha="0.5"
    >
    </div>
  </div>

  <div class="container-px">
    <SectionHeading eyebrow="Projects and Experience" title="What I've built & learned" />
    <p class="reveal mt-5 flex items-center gap-2 text-sm text-white/50" data-delay="200">
      <Icon name="info" class="h-4 w-4" />
      Tap or click any tag for a quick definition.
    </p>

    <div class="relative mt-16" data-timeline>
      <div class="timeline-rail" aria-hidden="true"><span class="timeline-fill"></span></div>

      <ol class="space-y-6">
        {
          experience.map((item) => (
            <li class="timeline-item reveal relative pl-10 sm:pl-16" data-reveal="right">
              <span class="timeline-dot" aria-hidden="true" />
              <article class="card-surface group p-6 sm:p-8" data-tilt="4">
                <div class="grid gap-5 sm:grid-cols-[9rem_1fr] sm:gap-8">
                  <div class="flex flex-row items-center gap-3 sm:flex-col sm:items-start">
                    <span class={`inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium ring-1 ${badge[item.kind].class}`}>
                      {badge[item.kind].label}
                    </span>
                    {item.period && <span class="font-mono text-xs text-white/55">{item.period}</span>}
                    {item.location && <span class="text-xs text-white/40">{item.location}</span>}
                  </div>

                  <div>
                    <h3 class="font-display text-2xl font-semibold text-white">
                      {item.org}
                    </h3>
                    <p class="mt-1 text-sm font-medium">
                      <span class="text-gradient">{item.role}</span>
                    </p>

                    <ul class="mt-5 space-y-3">
                      {item.points.map((p) => (
                        <li class="flex gap-3 text-sm leading-relaxed text-white/65">
                          <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rotate-45 rounded-[2px] bg-brand-gradient" />
                          {p}
                        </li>
                      ))}
                    </ul>

                    {item.tags && (
                      <ul class="mt-6 flex flex-wrap gap-2">
                        {item.tags.map((t) => {
                          const entry = lookup(t);
                          return (
                            <li>
                              {entry ? (
                                <button
                                  type="button"
                                  class="term-chip"
                                  data-term={entry.key}
                                  aria-haspopup="dialog"
                                  aria-expanded="false"
                                  aria-controls="term-card"
                                >
                                  {t}
                                </button>
                              ) : (
                                <span class="term-chip term-chip-static">{t}</span>
                              )}
                            </li>
                          );
                        })}
                      </ul>
                    )}

                    {item.link && (
                      <a
                        href={item.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group/link mt-6 inline-flex items-center gap-2 text-sm font-medium text-white/80 transition-colors hover:text-white"
                      >
                        <Icon name="github" class="h-4 w-4" />
                        View on GitHub
                        <Icon name="arrow" class="h-3.5 w-3.5 transition-transform group-hover/link:translate-x-1" />
                      </a>
                    )}
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- One definition card, filled and positioned by src/scripts/glossary.ts. -->
  <script is:inline type="application/json" id="glossary-data" set:html={JSON.stringify(glossary)} />
  <div id="term-card" class="term-card" role="dialog" aria-modal="false" aria-labelledby="term-card-title" tabindex="-1" hidden>
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/50" data-category></p>
        <h4 id="term-card-title" class="mt-1 font-display text-lg font-semibold text-white" data-title></h4>
      </div>
      <button type="button" class="term-card-close" aria-label="Close definition" data-close>
        <Icon name="close" class="h-4 w-4" />
      </button>
    </div>
    <p class="mt-3 text-sm leading-relaxed text-white/75" data-definition></p>
    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5" data-docs></ul>
  </div>
</section>

<script>
  import "../scripts/glossary";
</script>

