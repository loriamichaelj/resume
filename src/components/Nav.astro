---
import { nav } from "../data/site";
import Icon from "./Icon.astro";
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-40">
  <div class="container-px pt-3 sm:pt-4">
    <nav class="nav-shell flex h-14 items-center justify-between rounded-full pl-4 pr-2 sm:h-16 sm:pl-6 sm:pr-3">
      <a
        href="#top"
        class="group flex items-center gap-2 font-display text-lg font-bold tracking-tight text-white"
      >
        <span class="relative flex h-8 w-8 items-center justify-center rounded-xl bg-brand-gradient text-ink-950 shadow-[0_0_24px_-4px_rgb(var(--c-violet)_/_0.8)] transition-transform duration-500 group-hover:rotate-[-8deg] group-hover:scale-110">
          <Icon name="cloud" class="h-[18px] w-[18px]" />
        </span>
        <span><span class="text-gradient">loria</span><span class="text-white/40">.dev</span></span>
      </a>

      <ul class="relative hidden items-center md:flex" data-nav-desktop>
        <!-- Sliding pill under the active section (moved by motion.ts) -->
        <li
          id="nav-indicator"
          class="pointer-events-none absolute left-0 top-0 h-full rounded-full bg-white/[0.07] opacity-0 ring-1 ring-white/10"
          aria-hidden="true"
        >
        </li>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-full px-4 py-2 text-sm text-white/60 transition-colors hover:text-white [&.is-active]:text-white"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <!-- Light / dark theme toggle -->
        <button
          id="theme-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-white/80 transition-colors hover:border-white/30 hover:text-white"
          aria-label="Toggle light and dark mode"
        >
          <!-- Moon: shown in dark mode (tap to go light) -->
          <Icon name="moon" class="theme-icon-moon h-[18px] w-[18px]" />
          <!-- Sun: shown in light mode (tap to go dark) -->
          <Icon name="sun" class="theme-icon-sun h-[18px] w-[18px]" />
        </button>

        <!-- Mobile menu toggle -->
        <button
          id="nav-toggle"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-white/80 md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <Icon name="menu" class="h-5 w-5" />
        </button>
      </div>
    </nav>

    <!-- Mobile menu panel -->
    <div
      id="nav-panel"
      class="mt-2 hidden overflow-hidden rounded-3xl border border-white/10 bg-ink-900/90 backdrop-blur-xl md:hidden"
    >
      <ul class="flex flex-col gap-1 p-3">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block rounded-2xl px-4 py-3 text-base text-white/75 transition-colors hover:bg-white/5 hover:text-white"
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-panel");

  // Light / dark theme toggle. The initial theme is applied pre-paint by the
  // inline script in Layout.astro; here we just flip and persist on click.
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const isLight = document.documentElement.classList.toggle("light");
    try {
      localStorage.setItem("theme", isLight ? "light" : "dark");
    } catch {}
  });

  // Mobile menu open/close.
  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  panel?.querySelectorAll("[data-nav-link]").forEach((link) =>
    link.addEventListener("click", () => {
      panel.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
