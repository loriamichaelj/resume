---
import { profile, socials } from "../data/site";
import Icon from "./Icon.astro";
---

<section id="contact" class="relative scroll-mt-24 pb-24 pt-40 sm:pb-32 sm:pt-48">
  <div class="container-px">
    <div class="reveal" data-reveal="scale">
      <div
        class="card-surface card-clear relative px-6 pb-16 pt-24 text-center sm:px-12 sm:pb-20 sm:pt-28"
        data-scroll-center
      >
        <!-- The 3D cloud rises out of the top edge of this card. -->
        <div
          class="pointer-events-none absolute left-1/2 top-0 h-[14rem] w-[20rem] -translate-x-1/2 -translate-y-[62%] sm:w-[26rem]"
          data-cloud-anchor="5"
          data-cloud-alpha="0.95"
          aria-hidden="true"
        >
        </div>

        <p class="eyebrow relative flex justify-center">Contact</p>
        <h2 class="relative mx-auto mt-4 max-w-2xl font-display text-4xl font-bold tracking-tight sm:text-6xl">
          Let's build something <span class="text-gradient">together</span>.
        </h2>
        <p class="relative mx-auto mt-5 max-w-xl text-white/60">
          Open to software development roles and collaborations. The fastest way to
          reach me is by email.
        </p>

        {
          profile.email && (
            <a href={`mailto:${profile.email}`} class="btn-glow group relative mt-9" data-magnetic="0.2">
              <Icon name="email" class="h-4 w-4" />
              {profile.email}
            </a>
          )
        }

        <ul class="relative mt-10 flex items-center justify-center gap-3">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.icon === "email" ? undefined : "_blank"}
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="icon-btn"
                  data-magnetic="0.35"
                >
                  <Icon name={s.icon} class="h-[18px] w-[18px]" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
