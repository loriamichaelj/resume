---
import "../styles/global.css";
import { profile } from "../data/site";
import Scene3D from "../components/Scene3D.astro";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.bio,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#02050d" />

    <!-- Apply the saved/system theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("theme");
          const prefersLight = window.matchMedia(
            "(prefers-color-scheme: light)",
          ).matches;
          const light = saved ? saved === "light" : prefersLight;
          document.documentElement.classList.toggle("light", light);
        } catch {}
      })();
      // Rendering quality for the page's glass effects, also before first paint:
      // what the scene settled on last visit (src/scripts/scene/quality.ts),
      // else "low" for touch screens and obviously weak devices.
      (() => {
        let css = "";
        try {
          css = JSON.parse(localStorage.getItem("scene-quality") || "null")?.css || "";
        } catch {}
        const n = navigator;
        if (
          matchMedia("(pointer: coarse)").matches ||
          (n.hardwareConcurrency || 8) <= 2 ||
          (n.deviceMemory || 8) < 4 ||
          n.connection?.saveData
        ) {
          css = "low";
        }
        if (css) document.documentElement.dataset.quality = css;
      })();
    </script>
    <link rel="icon" href={withBase("favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("favicon-32.png")} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>

    <!-- Scroll progress -->
    <div
      id="scroll-progress"
      class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[2px] origin-left bg-aqua"
      style="transform: scaleX(0)"
      aria-hidden="true"
    >
    </div>

    <!-- Soft light that trails the cursor (desktop only, set by motion.ts) -->
    <div
      id="cursor-glow"
      class="pointer-events-none fixed left-0 top-0 -z-[1] h-[34rem] w-[34rem] rounded-full opacity-0 transition-opacity duration-700"
      style="background: radial-gradient(circle, rgb(var(--c-spot) / 0.12), transparent 70%)"
      aria-hidden="true"
    >
    </div>

    <Scene3D />

    <slot />

    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
